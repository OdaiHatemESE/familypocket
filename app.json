{
  "expo": {
    "name": "قديش",
    "slug": "masarifi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masarifi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2530",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.masarifi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "قديش",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق بيحتاج الوصول للصور عشان تختار صورة الفاتورة.",
          "cameraPermission": "التطبيق بيحتاج الكاميرا عشان تصوّر الفاتورة."
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0B2530",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "familypocket",
    "experiments": {
      "baseUrl": "/familypocket"
    }
  }
}
